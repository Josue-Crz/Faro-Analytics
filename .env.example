# Canonical operational database (local defaults match compose.yaml)
DATABASE_URL="postgresql://faro:faro_dev@localhost:5432/faro?schema=public"

# Explicit demo repository for the credential-free product tour.
# Set to "database" after applying migrations and seeding PostgreSQL.
FARO_DATA_SOURCE="demo"
FARO_DEMO_WORKSPACE_ID="ws-beacon-lab"
# Local development only. Keep false in deployments until real session authorization is wired.
FARO_ENABLE_UNAUTHENTICATED_DEMO_DB_ACCESS="false"

# Session/auth settings. Replace in every deployed environment.
AUTH_SECRET="replace-with-a-long-random-value"
APP_URL="http://localhost:3000"

# Reserved for a future Redis queue adapter. The shipped worker uses an explicit
# in-memory development repository and does not claim persistent job delivery.
REDIS_URL="redis://localhost:6379"

# Google OAuth is disabled until the client, redirect, session, and encryption values are configured.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google-sheets/callback"
TOKEN_ENCRYPTION_KEY=""
# Comma-separated email addresses allowed to enter the connected tester workspace.
# Leave empty only in local development; deployments fail closed.
FARO_TESTER_EMAILS=""
# Protects the deployment scheduler endpoints for Sheet refresh and optimizer schedule assignment.
FARO_SYNC_CRON_SECRET=""
# Worker-to-web URL and polling cadence for near-real-time Sheet refresh (minimum 15 seconds).
FARO_WEB_URL="http://localhost:3000"
FARO_SHEET_POLL_INTERVAL_MS="30000"
# Set false to disable verified Wikidata industry enrichment for companies whose source has no
# specific category. No API key is required.
FARO_WIKIDATA_ENRICHMENT_ENABLED="true"
# Protects worker-triggered follow-up notification scheduling. Required for SMS polling.
FARO_NOTIFICATION_CRON_SECRET=""
FARO_NOTIFICATION_POLL_INTERVAL_MS="30000"

# IBM Bob is connected through the Faro MCP server by default. Faro does not
# invent or assume a Bob network API. No non-Bob model/provider variables belong here.
FARO_MCP_TOKEN="replace-with-a-scoped-development-token"
BOB_RUNTIME_ADAPTER="unavailable" # Set to "bob-shell" only after installing and verifying Bob Shell locally.
# Used by the local IBM Bob Shell automation runtime when BOB_RUNTIME_ADAPTER="bob-shell".
# The Inference key must be tied to an active plan/entitlement; a present key does not prove the
# plan is active. Keep this value only in the ignored .env or a deployment secret manager—never
# commit a real key.
BOBSHELL_API_KEY=""

# Keep "preview" until every required Twilio value is configured and a test recipient is verified.
# In "twilio" mode, every due follow-up assigned to a verified, consenting user enters the SMS path.
NOTIFICATION_ADAPTER="preview"
TWILIO_ACCOUNT_SID=""
TWILIO_API_KEY=""
TWILIO_API_SECRET=""
# Configure either a Messaging Service SID or an E.164 sender number.
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_FROM_NUMBER=""
# Twilio Verify service used before a user can opt in a mobile recipient.
TWILIO_VERIFY_SERVICE_SID=""
