{
  "name": "faro-analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Governed relationship-intelligence workspace for explainable follow-ups and human-reviewed outreach",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @faro/mcp... --if-present build && pnpm --filter @faro/web dev",
    "worker": "pnpm --filter @faro/worker dev",
    "mcp:faro": "pnpm --filter @faro/mcp start",
    "mcp:sheets": "pnpm --filter @faro/google-sheets-mcp start",
    "build": "pnpm -r --if-present build",
    "clean": "pnpm -r --if-present clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run tests/integration",
    "test:database": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run packages/faro-mcp/src/prisma-backend.integration.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @faro/database generate",
    "db:validate": "pnpm --filter @faro/database validate",
    "db:migrate": "pnpm --filter @faro/database migrate:dev",
    "db:deploy": "pnpm --filter @faro/database migrate:deploy",
    "db:seed": "pnpm --filter @faro/database seed",
    "docs:check": "node scripts/check-docs.mjs",
    "check:ai-boundary": "tsx scripts/check-ai-boundary.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.4",
    "@faro/core": "workspace:*",
    "@faro/google-sheets": "workspace:*",
    "@faro/ibm-bob": "workspace:*",
    "@faro/notifications": "workspace:*",
    "@faro/optimizer": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "globals": "^16.5.0",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.1.10"
  }
}
